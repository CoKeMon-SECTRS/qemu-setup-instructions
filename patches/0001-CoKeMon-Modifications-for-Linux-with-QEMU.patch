diff --git a/arch/arm64/include/asm/rmi_cmds.h b/arch/arm64/include/asm/rmi_cmds.h
index 043b7ff27..73a2fbee4 100644
--- a/arch/arm64/include/asm/rmi_cmds.h
+++ b/arch/arm64/include/asm/rmi_cmds.h
@@ -7,6 +7,7 @@
 #define __ASM_RMI_CMDS_H
 
 #include <linux/arm-smccc.h>
+#include <linux/interrupt.h>
 
 #include <asm/rmi_smc.h>
 
@@ -183,6 +184,55 @@ static inline int rmi_realm_activate(unsigned long rd)
 	return res.a0;
 }
 
+static inline int rmi_os_switch_print(u64 addr, u64 len)
+{
+	struct arm_smccc_res res;
+
+	pr_debug("------------- CALL TO OS SWITCH Print %x --------------\n", SMC_RMI_OS_SWITCH);
+
+	arm_smccc_1_1_invoke(SMC_RMI_OS_SWITCH, addr, len, 2, &res);
+
+	return res.a0;
+}
+
+static inline int rmi_os_switch_print_count(int module)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_1_1_invoke(SMC_RMI_PRINT_COUNT,SMC_RMI_PRINT_COUNT,0,module, &res);
+
+	return res.a0;
+}
+
+static inline int rmi_os_switch_zero_count(int module)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_1_1_invoke(SMC_RMI_ZERO_COUNT,SMC_RMI_ZERO_COUNT,0,module, &res);
+
+	return res.a0;
+}
+
+static inline int rmi_os_switch_page(u64 addr)
+{
+	struct arm_smccc_res res;
+
+	pr_debug("------------- CALL TO OS SWITCH Page %x --------------\n", SMC_RMI_OS_SWITCH);
+
+	arm_smccc_1_1_invoke(SMC_RMI_OS_SWITCH, addr, 0, 1, &res);
+
+	return res.a0;
+}
+
+static inline int rmi_os_switch(void)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_1_1_invoke(SMC_RMI_OS_SWITCH, &res);
+
+	return res.a0;
+}
+
 /**
  * rmi_realm_create() - Create a realm
  * @rd: PA of the RD
