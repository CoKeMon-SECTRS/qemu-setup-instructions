diff --git a/drivers/misc/bench_count/bench_count.c b/drivers/misc/bench_count/bench_count.c
new file mode 100644
index 000000000..cf07986c4
--- /dev/null
+++ b/drivers/misc/bench_count/bench_count.c
@@ -0,0 +1,137 @@
+#include <linux/atomic.h>
+#include <linux/cdev.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/printk.h>
+#include <linux/types.h>
+#include <linux/version.h>
+
+#include <asm/errno.h>
+#include <asm/rmi_cmds.h>
+
+#include <asm/cacheflush.h>
+
+static int device_open(struct inode *, struct file *);
+static int device_release(struct inode *, struct file *);
+static ssize_t device_write(struct file *, const char __user *, size_t,
+                            loff_t *);
+
+#define DEVICE_NAME "bench_count" /* Dev name as it appears in /proc/devices   */
+#define LOG_BUFFER_SIZE 4096
+
+static int major; /* major number assigned to our device driver */
+
+static u8 * kernel_log_buf;
+
+static struct class *cls;
+
+static struct file_operations chardev_fops = {
+    .write = device_write,
+    .open = device_open,
+    .release = device_release,
+};
+
+static char *chardev_devnode(const struct device *dev, umode_t *mode)
+{
+    if (mode != NULL)
+        *mode = 0222;
+    return NULL;
+}
+
+static int __init chardev_init(void)
+{
+    major = register_chrdev(0, DEVICE_NAME, &chardev_fops);
+
+    if (major < 0) {
+        pr_alert("Registering char device failed with %d\n", major);
+        return major;
+    }
+
+    pr_debug("%s was assigned major number %d.\n", DEVICE_NAME, major);
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 4, 0)
+    cls = class_create(DEVICE_NAME);
+#else
+    cls = class_create(THIS_MODULE, DEVICE_NAME);
+#endif
+    cls->devnode = &chardev_devnode; 
+    device_create(cls, NULL, MKDEV(major, 0), NULL, DEVICE_NAME);
+
+    // counter=0;
+    // total_len=0;
+
+    pr_debug("Device created on /dev/%s\n", DEVICE_NAME);
+
+    return 0;
+}
+
+static void __exit chardev_exit(void)
+{
+    device_destroy(cls, MKDEV(major, 0));
+    class_destroy(cls);
+
+    /* Unregister the device */
+    unregister_chrdev(major, DEVICE_NAME);
+}
+
+/* Methods */
+
+/* Called when a process tries to open the device file, like
+ * "sudo cat /dev/chardev"
+ */
+static int device_open(struct inode *inode, struct file *file)
+{
+	pr_info("Open device %s\n",DEVICE_NAME);
+	kernel_log_buf = kmalloc(LOG_BUFFER_SIZE, GFP_KERNEL);
+	if (!kernel_log_buf)
+		return -ENOMEM;
+	return 0;
+}
+
+/* Called when a process closes the device file. */
+static int device_release(struct inode *inode, struct file *file)
+{
+    kfree(kernel_log_buf);
+    pr_info("Device %s released\n",DEVICE_NAME);
+    return 0;
+}
+
+static ssize_t device_write(struct file *filp, const char __user *buff,
+			    size_t len, loff_t *off)
+{
+	int offset;
+	// pr_info("Write %zu bytes to %s - total length is %zu\n", len,DEVICE_NAME, total_len);
+
+	if (copy_from_user(kernel_log_buf, buff, len)) {
+		pr_err("Failed to copy data from user space\n");
+		return -EFAULT;
+	}
+
+	if(strncmp(kernel_log_buf, "ZEROLOG", 7)==0){
+		rmi_os_switch_zero_count(2);
+		return len;
+	}
+	if(strncmp(kernel_log_buf, "PRINTLOG", 8)==0){
+		rmi_os_switch_print_count(2);
+		return len;
+	}
+	if(strncmp(kernel_log_buf, "ZEROPT", 6)==0){
+		rmi_os_switch_print_count(3);
+		return len;
+	}
+	if(strncmp(kernel_log_buf, "PRINTPT", 7)==0){
+		rmi_os_switch_print_count(4);
+		return len;
+	}
+
+
+	return len;
+}
+
+module_init(chardev_init);
+module_exit(chardev_exit);
+
+MODULE_LICENSE("GPL");
