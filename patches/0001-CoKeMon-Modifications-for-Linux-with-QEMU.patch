+		// pr_info("Addr: %llx \n",buff_addr);
+		// pr_info("Len: %zu \n",total_len);
+
+	uint64_t full_addr = (uint64_t)(buff_offset*LOG_BUFFER_SIZE+kernel_log_buf+offset-len);
+	dcache_clean_inval_poc(full_addr, (full_addr+len));
