+static int check_list(pte_t *pte){
+	for(int i=0;i<skip_ptes_count;i++){
+		if(skipped_ptes[i] == pte){
+			return 1;
+		}
+	}
+	return 0;
+}
+
+static void save_ptes(pte_t *current_pte,pte_t *next_pte){
+	// __set_pte_nosync(current_pte, pte_wrprotect(*current_pte));
+	total_ptes_count++;
+	if(check_list(current_pte)){
+		tentative_in_list_read_only++;
+		return;
+	}
+	if(!pte_rdonly(*next_pte)){
+		skipped_ptes[skip_ptes_count]=current_pte;
+		skip_ptes_count++;
+		// skipped_sub_ptes_count++;
+		if(skip_ptes_count>=2000){
+			pr_err("Overflow of skip_ptes_count");
+			skip_ptes_count=0;
+		}
+		return;
+	}else{
+		pr_err("No adding pte %lx that we cannot modify",(unsigned long)current_pte);
+	}
+}
+
+static int get_ptes(unsigned long vaddr){
+	pte_t *current_pte = virt_to_kpte(vaddr);
+	pte_t *next_pte = virt_to_kpte((unsigned long)current_pte);
+	// set_ptes_ro(current_pte, next_pte);
+	save_ptes(current_pte, next_pte);
+	if((unsigned long)current_pte==(unsigned long)next_pte){
+		return 1;
+	}
+	for(int i=1;i<MAX_PTE_LOOKUP;i++){
+		current_pte = next_pte;
+		next_pte = virt_to_kpte((unsigned long)current_pte);
+		// set_ptes_ro(current_pte, next_pte);
+		save_ptes(current_pte, next_pte);
+		if((unsigned long)next_pte==(unsigned long)current_pte){
+			return i+1;
+		}
+	}
+	pr_err("Reached %d pte of pte, maximum should be 5\n",MAX_PTE_LOOKUP);
+	return -EINVAL;
+}
